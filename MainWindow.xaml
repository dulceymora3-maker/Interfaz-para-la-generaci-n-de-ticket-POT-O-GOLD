<Window x:Class="PrometeoTicketHP.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PROMETEO | Ticket HP" Width="1000" Height="700" MinWidth="690" MinHeight="520" Background="#303236" WindowStartupLocation="CenterScreen">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#F2F2F2"/><Setter Property="Foreground" Value="#292B30"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="18,12"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#252525"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="15"/></Style>
</Window.Resources>
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border BorderBrush="#74777C" BorderThickness="1" CornerRadius="10" Background="#414449" Padding="14"><Image Source="Assets/PrometeoLogo.png" Width="240" Stretch="Uniform" HorizontalAlignment="Right"/></Border>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel HorizontalAlignment="Center" Width="600" MaxWidth="600" Margin="0,55,0,20">
<TextBlock Text="Ingresar monto" Foreground="White" FontSize="17" Margin="0,22,0,7"/><TextBox Name="Monto" Text="200" TextChanged="Monto_TextChanged"/>
<TextBlock Name="CreditosVista" Text="Créditos: 50" Foreground="White" FontSize="18" Margin="0,12,0,0"/><TextBlock Text="Puerto COM" Foreground="White" FontSize="17" Margin="0,18,0,7"/><ComboBox Name="Puertos" Height="36" Background="White"/>
<Button Content="HP" Click="Preparar_Click" Height="60" Margin="0,25,0,12"/>
<Button Content="Imprimir ticket" Click="Imprimir_Click" Height="60" Margin="0,0,0,12"/>
<TextBlock Name="Estado" Foreground="White" Margin="0,15,0,0" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></Grid></Window>
